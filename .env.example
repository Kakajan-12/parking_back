#########################################
# DATABASE CONFIGURATION
#########################################

# PostgreSQL connection URL
# Format: host=<HOST> user=<USERNAME> password=<PASSWORD> dbname=<DBNAME> port=<PORT> sslmode=<SSL_MODE>
# DATABASE_URL="host=127.0.0.1 user=change_this password=change_this dbname=parking port=5432 sslmode=disable"
DATABASE_URL="postgres://user:password@localhost:5432/change_this?sslmode=disable"

#########################################
# BACKEND SERVER CONFIGURATION
#########################################

# Host and port for the backend server
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"

#########################################
# EXTERNAL SERVICES
#########################################

# Macroscop service URL
MACROSCOP_URL="127.0.0.1:8080"
MACROSCOP_USERNAME="admin"
MACROSCOP_PASSWORD="admin"

# Image storage paths
# URL path for serving static files
STATIC_URL="/static"
# Local path where static files are stored
STATIC_DIR="static"

# Media storage paths
# URL path for serving media files
MEDIA_URL="/media"
# Local path where media files are stored
MEDIA_DIR="media"

#########################################
# SECURITY
#########################################

# Secret key for JWT authentication set full path on os
# JWT_PRIVATE_KEY_PATH="security/private.pem"
# JWT_PUBLIC_KEY_PATH="security/public.pem"

#########################################
# CORS CONFIGURATION
#########################################

# Allowed origins for Cross-Origin Resource Sharing (CORS)
# Multiple origins can be separated by commas
CORS_ALLOW_ORIGINS="http://localhost:3000, http://127.0.0.1:3000"

#########################################
# INITIAL DATABASE SETUP
#########################################

# Credentials for the first superuser (used when initializing the database)
FIRST_SUPER_USERNAME="admin"
FIRST_SUPERUSER_PASSWORD="change_this"

#########################################
# NOTES
#########################################

# 1. Replace all placeholder values (like 'change_this') with your actual credentials.
# 2. Never commit sensitive information (passwords, secret keys) to a public repository.
# 3. Ensure the IMAGE_URL path matches the route served by your backend.
# 4. Update CORS_ALLOW_ORIGINS according to your frontend deployment URL.

# App deployment state
APP_ENV=development